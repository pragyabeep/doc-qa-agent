# --- LLM (any OpenAI-compatible API; example: Groq) ---
XAI_API_KEY=your-api-key-here
XAI_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Leave empty to omit the parameter (some reasoning models restrict it)
LLM_TEMPERATURE=0

# --- Langfuse (leave empty to run without tracing) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Experiment knobs (used for before/after evals) ---
PROMPT_VERSION=v2        # v1 = baseline prompt, v2 = strict prompt
RETRIEVAL_MODE=hybrid    # vector | keyword | hybrid
TOP_K=4

# Optional: lets the API report an estimated cost per request (USD per 1M tokens)
PRICE_IN_PER_M=
PRICE_OUT_PER_M=
